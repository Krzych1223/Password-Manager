<Window x:Class="Password_Manager.GUI.VaultSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Manager - Vault Selector"
        Width="490"
        Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Arial, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="24">
        <Border Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header / Logo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,22" HorizontalAlignment="Center">
                    <Border Width="52" Height="52"
                            Background="#22222C"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="26"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                              Fill="{StaticResource PrimaryAccentBrush}"
                              Stretch="Uniform"
                              Width="26" Height="26"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Password Manager"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Select or unlock your encrypted vault"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Vault File (.vlt) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="Vault File (.vlt)"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VaultFileTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="Drop a .vlt file here or click Browse..." />
                        <Button x:Name="BrowseVaultButton"
                                Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="BrowseVaultButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- Key File (optional) -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Key File"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text=" (optional)"
                                   FontSize="11"
                                   Foreground="#71717A" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyFileTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="Optional key file (*.key, *.dat)" />
                        <Button x:Name="BrowseKeyButton"
                                Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="BrowseKeyButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- Master Password -->
                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <TextBlock Text="Master Password"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="MasterPasswordBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernPasswordBoxStyle}"
                                     PasswordChanged="MasterPasswordBox_PasswordChanged" />
                        <TextBox x:Name="MasterPasswordVisibleTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Visibility="Collapsed"
                                 TextChanged="MasterPasswordVisibleTextBox_TextChanged" />
                        <Button x:Name="TogglePasswordVisibilityButton"
                                Grid.Column="1"
                                Content="👁"
                                Width="38"
                                ToolTip="Show / Hide password"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="TogglePasswordVisibilityButton_Click" />
                    </Grid>
                </StackPanel>

                <!-- Cipher Selection -->
                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <TextBlock Text="Cipher Engine"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="CipherComboBox"
                              SelectedIndex="0"
                              Background="{StaticResource InputBgBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Height="36"
                              Padding="8,6"
                              FontSize="13">
                        <ComboBoxItem Content="AES (AES-256 GCM)" IsSelected="True" />
                        <ComboBoxItem Content="ChaCha20 (ChaCha20-Poly1305)" />
                    </ComboBox>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock x:Name="StatusMessageTextBlock"
                           Grid.Row="5"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,2,0,10"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed" />

                <!-- Action Buttons -->
                <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
                    <Button x:Name="UnlockVaultButton"
                            Content="Unlock Vault"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42"
                            Click="UnlockVaultButton_Click" />

                    <!-- Divider -->
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Separator Grid.Column="0" Height="1" Background="{StaticResource BorderBrush}" />
                        <TextBlock Grid.Column="1" Text="OR" FontSize="11" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Separator Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" />
                    </Grid>

                    <Button x:Name="CreateVaultButton"
                            Content="Create New Vault"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"
                            Click="CreateVaultButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
